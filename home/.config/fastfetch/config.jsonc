{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/dominik/.config/fastfetch/logo-tinted.png",
    "type": "kitty-direct",
    "width": 30,
    "height": 15,
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "keyColor": "38;2;184;170;137"
    },
    {
      "type": "separator",
      "string": "\u2500"
    },
    {
      "type": "os",
      "key": "os",
      "keyColor": "38;2;184;170;137"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "keyColor": "38;2;184;170;137"
    },
    {
      "type": "uptime",
      "key": "uptime",
      "keyColor": "38;2;184;170;137"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "keyColor": "38;2;184;170;137"
    },
    {
      "type": "shell",
      "key": "shell",
      "keyColor": "38;2;184;170;137"
    },
    {
      "type": "wm",
      "key": "wm",
      "keyColor": "38;2;184;170;137"
    },
    {
      "type": "terminal",
      "key": "term",
      "keyColor": "38;2;184;170;137"
    },
    {
      "type": "cpu",
      "key": "cpu",
      "keyColor": "38;2;201;193;176"
    },
    {
      "type": "gpu",
      "key": "gpu",
      "keyColor": "38;2;201;193;176"
    },
    {
      "type": "memory",
      "key": "mem",
      "keyColor": "38;2;201;193;176"
    },
    {
      "type": "disk",
      "key": "disk",
      "keyColor": "38;2;201;193;176"
    },
    {
      "type": "battery",
      "key": "bat",
      "keyColor": "38;2;201;193;176"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}