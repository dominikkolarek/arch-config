#!/usr/bin/env python3
"""
Set a wallpaper and regenerate the waybar colour palette from it.

    set-wallpaper ~/Pictures/wallpapers/wall.png
    set-wallpaper --random          # pick one from the wallpapers dir
    set-wallpaper --regen           # rebuild colours from current wallpaper

Writes ~/.config/waybar/colors.css, which style.css imports.
"""

import colorsys
import json
import random
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
WALLPAPER_DIR = HOME / "Pictures/wallpapers"
STATE_FILE = HOME / ".local/state/current-wallpaper"
COLORS_CSS = HOME / ".config/waybar/colors.css"
KITTY_COLORS = HOME / ".config/kitty/colors.conf"
NANO_COLORS = HOME / ".config/nano/colors.nanorc"
HYPRLOCK_COLORS = HOME / ".config/hypr/lock-colors.conf"
FASTFETCH_CONF = HOME / ".config/fastfetch/config.jsonc"
SWAYNC_CSS = HOME / ".config/swaync/style.css"
GTK3_CSS = HOME / ".config/gtk-3.0/gtk.css"
GTK4_CSS = HOME / ".config/gtk-4.0/gtk.css"
logo_img = HOME / "Pictures/the_fool.png"

EXTENSIONS = {".png", ".jpg", ".jpeg", ".webp"}

# Keep generated colours inside these bounds so text stays readable
# no matter how garish the wallpaper is.
ACCENT_MIN_SAT = 0.25
ACCENT_MAX_SAT = 0.60
ACCENT_MIN_LIGHT = 0.55
ACCENT_MAX_LIGHT = 0.75


def die(message: str) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(1)


def dominant_color(image: Path) -> tuple[int, int, int]:
    try:
        from colorthief import ColorThief
    except ImportError:
        die("python-colorthief not installed: sudo pacman -S python-colorthief")

    thief = ColorThief(str(image))
    # quality=5 is a reasonable speed/accuracy tradeoff on a 1080p image
    palette = thief.get_palette(color_count=5, quality=5)

    # Prefer the most saturated of the top colours; the literal dominant
    # colour is often a washed-out sky or a near-black background.
    def saturation(rgb):
        r, g, b = (c / 255 for c in rgb)
        return colorsys.rgb_to_hls(r, g, b)[2]

    return max(palette, key=saturation)


def clamp(value: float, low: float, high: float) -> float:
    return max(low, min(value, high))


def hsl_to_hex(h: float, s: float, l: float) -> str:
    r, g, b = colorsys.hls_to_rgb(h, l, s)
    return "#{:02x}{:02x}{:02x}".format(
        round(r * 255), round(g * 255), round(b * 255)
    )


def build_palette(rgb: tuple[int, int, int]) -> dict[str, str]:
    r, g, b = (c / 255 for c in rgb)
    hue, _, sat = colorsys.rgb_to_hls(r, g, b)

    accent_sat = clamp(sat, ACCENT_MIN_SAT, ACCENT_MAX_SAT)

    return {
        # Backgrounds: same hue, very dark, low saturation
        "bg":       hsl_to_hex(hue, accent_sat * 0.25, 0.07),
        "bg-alt":   hsl_to_hex(hue, accent_sat * 0.22, 0.11),
        "hover":    hsl_to_hex(hue, accent_sat * 0.25, 0.16),
        "muted":    hsl_to_hex(hue, accent_sat * 0.30, 0.28),

        # Foregrounds: same hue, progressively lighter
        "dim":      hsl_to_hex(hue, accent_sat * 0.45, 0.50),
        "accent":   hsl_to_hex(hue, accent_sat, 0.63),
        "light":    hsl_to_hex(hue, accent_sat * 0.75, 0.74),
        "lightest": hsl_to_hex(hue, accent_sat * 0.55, 0.85),

        # Warnings stay red regardless of wallpaper — a warning that
        # blends into the theme stops being a warning.
        "warn":     "#d98d8d",
        "warn-bg":  "#4a2a2a",
    }


def write_css(palette: dict[str, str], source: Path) -> None:
    COLORS_CSS.parent.mkdir(parents=True, exist_ok=True)
    lines = [
        "/* Generated by set-wallpaper. Do not edit by hand. */",
        f"/* Source: {source} */",
        "",
    ]
    lines += [f"@define-color {name} {value};" for name, value in palette.items()]
    lines.append("")
    COLORS_CSS.write_text("\n".join(lines), encoding="utf-8")


def wallpapers() -> list[Path]:
    if not WALLPAPER_DIR.is_dir():
        die(f"{WALLPAPER_DIR} does not exist")
    found = [p for p in sorted(WALLPAPER_DIR.iterdir())
             if p.suffix.lower() in EXTENSIONS]
    if not found:
        die(f"no images in {WALLPAPER_DIR}")
    return found


def apply_wallpaper(image: Path) -> None:
    subprocess.run(
        ["awww", "img", str(image),
         "--transition-type", "fade",
         "--transition-duration", "1"],
        check=False,
    )


def restart_waybar() -> None:
    subprocess.run(["killall", "waybar"], check=False,
                   stderr=subprocess.DEVNULL)
    subprocess.Popen(
        ["waybar"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def resolve_target(argv: list[str]) -> Path:
    if not argv:
        die("usage: set-wallpaper <image> | --random | --regen")

    arg = argv[0]

    if arg == "--random":
        current = STATE_FILE.read_text().strip() if STATE_FILE.exists() else ""
        choices = [p for p in wallpapers() if str(p) != current]
        return random.choice(choices or wallpapers())

    if arg == "--regen":
        if not STATE_FILE.exists():
            die("no current wallpaper recorded")
        return Path(STATE_FILE.read_text().strip())

    image = Path(arg).expanduser().resolve()
    if not image.is_file():
        die(f"{image} not found")
    return image

HYPR_COLORS = HOME / ".config/hypr/colors.lua"


def write_hypr_colors(palette: dict[str, str]) -> None:
    def to_rgba(hex_color: str) -> str:
        return "rgba(" + hex_color.lstrip("#") + "ff)"

    HYPR_COLORS.parent.mkdir(parents=True, exist_ok=True)
    lines = [
        "-- Generated by set-wallpaper. Do not edit by hand.",
        "return {",
        f'    accent   = "{to_rgba(palette["accent"])}",',
        f'    dim      = "{to_rgba(palette["dim"])}",',
        f'    muted    = "{to_rgba(palette["muted"])}",',
        f'    bg       = "{to_rgba(palette["bg"])}",',
        f'    bg_plain = "rgb({palette["bg"].lstrip("#")})",',
        f'    accent_plain = "rgb({palette["accent"].lstrip("#")})",',
        f'    dim_plain    = "rgb({palette["dim"].lstrip("#")})",',
        "}",
        "",
    ]
    HYPR_COLORS.write_text("\n".join(lines), encoding="utf-8")

def write_kitty_colors(palette: dict[str, str]) -> None:
    KITTY_COLORS.parent.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Generated by set-wallpaper. Do not edit by hand.",
        "",
        f"background            {palette['bg']}",
        f"foreground            {palette['lightest']}",
        f"cursor                {palette['accent']}",
        f"cursor_text_color     {palette['bg']}",
        f"selection_background  {palette['accent']}",
        f"selection_foreground  {palette['bg']}",
        f"url_color             {palette['light']}",
        "",
        f"active_tab_background   {palette['accent']}",
        f"active_tab_foreground   {palette['bg']}",
        f"inactive_tab_background {palette['bg-alt']}",
        f"inactive_tab_foreground {palette['dim']}",
        "",
        f"active_border_color   {palette['accent']}",
        f"inactive_border_color {palette['muted']}",
        "",
    ]
    KITTY_COLORS.write_text("\n".join(lines), encoding="utf-8")

NANO_RC = HOME / ".config/nano/nanorc"


def write_nano_colors(palette: dict[str, str]) -> None:
    n = {k: to_nano_hex(v) for k, v in palette.items()}
    lines = [
        "# Generated by set-wallpaper. Do not edit by hand.",
        "",
        "set linenumbers",
        "set constantshow",
        "set tabsize 4",
        "set tabstospaces",
        "set softwrap",
        "set mouse",
        "",
        f"set titlecolor      {n['bg']},{n['accent']}",
        f"set numbercolor     {n['dim']}",
        f"set statuscolor     {n['bg']},{n['accent']}",
        f"set keycolor        {n['accent']}",
        f"set functioncolor   {n['light']}",
        f"set promptcolor     {n['lightest']},{n['bg-alt']}",
        f"set selectedcolor   {n['bg']},{n['light']}",
        f"set stripecolor     {n['muted']}",
        f"set scrollercolor   {n['accent']}",
        f"set spotlightcolor  {n['bg']},{n['light']}",
        f"set minicolor       {n['lightest']}",
        f"set errorcolor      {n['bg']},{n['warn']}",
        "",
        'include "/usr/share/nano/*.nanorc"',
        "",
    ]
    NANO_RC.write_text("\n".join(lines), encoding="utf-8")

def write_hyprlock_colors(palette: dict[str, str]) -> None:
    def plain(hex_color: str) -> str:
        return "rgb(" + hex_color.lstrip("#") + ")"

    HYPRLOCK_COLORS.parent.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Generated by set-wallpaper. Do not edit by hand.",
        "",
        f"$accent   = {plain(palette['accent'])}",
        f"$bg       = {plain(palette['bg'])}",
        f"$bg_alt   = {plain(palette['bg-alt'])}",
        f"$dim      = {plain(palette['dim'])}",
        f"$light    = {plain(palette['light'])}",
        f"$lightest = {plain(palette['lightest'])}",
        f"$warn     = {plain(palette['warn'])}",
        "",
        f"$accent_hex   = {palette['accent'].lstrip('#')}",
        f"$dim_hex      = {palette['dim'].lstrip('#')}",
        f"$warn_hex     = {palette['warn'].lstrip('#')}",
        "",
    ]
    HYPRLOCK_COLORS.write_text("\n".join(lines), encoding="utf-8")

def write_fastfetch(palette: dict[str, str]) -> None:

    def ansi(hex_color: str) -> str:
        h = hex_color.lstrip("#")
        r, g, b = (int(h[i:i+2], 16) for i in (0, 2, 4))
        return f"38;2;{r};{g};{b}"

    tinted = HOME / ".config/fastfetch/logo-tinted.png"

    if logo_img.exists():
        tinted.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run([
            "magick", str(logo_img),
            "-trim", "+repage",
            "-fuzz", "20%", "-transparent", "white",
            "-fill", palette["accent"], "-colorize", "100",
            str(tinted),
        ], check=False)
        logo_conf = {
            "source": str(tinted),
            "type": "kitty-direct",
            "width": 30,
            "height": 15,
            "padding": {"top": 1, "right": 3},
        }
    else:
        logo_conf = {"type": "small", "padding": {"top": 1, "right": 3}}
    config = {
        "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
        "logo": logo_conf,
        "display": {"separator": "  "},
        "modules": [
            "break",
            {"type": "title", "keyColor": ansi(palette["accent"])},
            {"type": "separator", "string": "─"},
            {"type": "os", "key": "os", "keyColor": ansi(palette["accent"])},
            {"type": "kernel", "key": "kernel", "keyColor": ansi(palette["accent"])},
            {"type": "uptime", "key": "uptime", "keyColor": ansi(palette["accent"])},
            {"type": "packages", "key": "pkgs", "keyColor": ansi(palette["accent"])},
            {"type": "shell", "key": "shell", "keyColor": ansi(palette["accent"])},
            {"type": "wm", "key": "wm", "keyColor": ansi(palette["accent"])},
            {"type": "terminal", "key": "term", "keyColor": ansi(palette["accent"])},
            {"type": "cpu", "key": "cpu", "keyColor": ansi(palette["light"])},
            {"type": "gpu", "key": "gpu", "keyColor": ansi(palette["light"])},
            {"type": "memory", "key": "mem", "keyColor": ansi(palette["light"])},
            {"type": "disk", "key": "disk", "keyColor": ansi(palette["light"])},
            {"type": "battery", "key": "bat", "keyColor": ansi(palette["light"])},
            "break",
            {"type": "colors", "symbol": "circle"},
            "break",
        ],
    }
    FASTFETCH_CONF.parent.mkdir(parents=True, exist_ok=True)
    FASTFETCH_CONF.write_text(json.dumps(config, indent=2), encoding="utf-8")

def write_firefox_css(palette: dict[str, str]) -> None:
    roots = [
        HOME / ".config/mozilla/firefox",
        HOME / ".mozilla/firefox",
    ]

    targets = []
    for root in roots:
        if not root.is_dir():
            continue
        targets += [p for p in root.iterdir()
                    if p.is_dir() and (p / "prefs.js").exists()]

    if not targets:
        return

    css = f"""/* Generated by set-wallpaper. Do not edit by hand. */

:root {{
    --accent:   {palette['accent']};
    --bg:       {palette['bg']};
    --bg-alt:   {palette['bg-alt']};
    --hover:    {palette['hover']};
    --muted:    {palette['muted']};
    --dim:      {palette['dim']};
    --light:    {palette['light']};
    --lightest: {palette['lightest']};
}}

#navigator-toolbox {{
    background: var(--bg) !important;
    border-bottom: 1px solid var(--muted) !important;
}}

#TabsToolbar, #nav-bar, #PersonalToolbar {{
    background: var(--bg) !important;
}}

.tabbrowser-tab .tab-background {{
    background: transparent !important;
    border-radius: 7px !important;
    margin: 3px 2px !important;
}}

.tabbrowser-tab[selected] .tab-background {{
    background: var(--bg-alt) !important;
    box-shadow: inset 0 -2px 0 var(--accent) !important;
}}

.tabbrowser-tab:hover:not([selected]) .tab-background {{
    background: var(--hover) !important;
}}

.tab-label {{
    color: var(--dim) !important;
}}

.tabbrowser-tab[selected] .tab-label {{
    color: var(--lightest) !important;
}}

#urlbar-background {{
    background: var(--bg-alt) !important;
    border: 1px solid var(--muted) !important;
    border-radius: 8px !important;
}}

#urlbar[focused="true"] > #urlbar-background {{
    border-color: var(--accent) !important;
}}

#urlbar-input, #urlbar-input::placeholder {{
    color: var(--lightest) !important;
}}

toolbar .toolbarbutton-1 > .toolbarbutton-icon {{
    fill: var(--light) !important;
    color: var(--light) !important;
}}

toolbar .toolbarbutton-1:hover > .toolbarbutton-icon {{
    background: var(--hover) !important;
    border-radius: 6px !important;
}}

#sidebar-box, #sidebar-header {{
    background: var(--bg) !important;
    color: var(--lightest) !important;
}}

.urlbarView-row[selected] > .urlbarView-row-inner,
.urlbarView-row:hover > .urlbarView-row-inner {{
    background: var(--hover) !important;
    border-radius: 6px !important;
}}
"""

    for profile in targets:
        chrome = profile / "chrome"
        chrome.mkdir(exist_ok=True)
        (chrome / "userChrome.css").write_text(css, encoding="utf-8")

def write_swaync_css(palette: dict[str, str]) -> None:
    css = f"""/* Generated by set-wallpaper. Do not edit by hand. */

* {{
    font-family: "JetBrainsMono Nerd Font";
    font-size: 13px;
}}

.control-center {{
    background: {palette['bg']};
    border: 1px solid {palette['muted']};
    border-radius: 12px;
    color: {palette['lightest']};
}}

.control-center .notification-row .notification-background {{
    background: {palette['bg-alt']};
    border-radius: 9px;
    margin: 4px 6px;
    padding: 4px;
}}

.control-center .notification-row .notification-background:hover {{
    background: {palette['hover']};
}}

.notification-content {{
    color: {palette['lightest']};
    padding: 6px;
}}

.summary {{
    color: {palette['accent']};
    font-weight: 600;
}}

.body {{
    color: {palette['dim']};
}}

.close-button {{
    background: transparent;
    color: {palette['dim']};
    border-radius: 6px;
}}

.close-button:hover {{
    background: {palette['warn-bg']};
    color: {palette['warn']};
}}

.widget-title {{
    color: {palette['accent']};
    font-size: 15px;
    padding: 8px 12px;
}}

.widget-dnd {{
    color: {palette['lightest']};
    padding: 8px 12px;
}}

.widget-dnd > switch {{
    background: {palette['bg-alt']};
    border-radius: 12px;
}}

.widget-dnd > switch:checked {{
    background: {palette['accent']};
}}

.floating-notifications .notification-background {{
    background: {palette['bg']};
    border: 1px solid {palette['muted']};
    border-radius: 10px;
    margin: 8px;
}}
"""
    SWAYNC_CSS.parent.mkdir(parents=True, exist_ok=True)
    SWAYNC_CSS.write_text(css, encoding="utf-8")


def write_gtk_css(palette: dict[str, str]) -> None:
    css = f"""/* Generated by set-wallpaper. Do not edit by hand. */

@define-color accent_color {palette['accent']};
@define-color accent_bg_color {palette['accent']};
@define-color accent_fg_color {palette['bg']};

@define-color window_bg_color {palette['bg']};
@define-color window_fg_color {palette['lightest']};

@define-color view_bg_color {palette['bg']};
@define-color view_fg_color {palette['lightest']};

@define-color headerbar_bg_color {palette['bg-alt']};
@define-color headerbar_fg_color {palette['lightest']};
@define-color headerbar_border_color {palette['muted']};

@define-color sidebar_bg_color {palette['bg-alt']};
@define-color sidebar_fg_color {palette['lightest']};
@define-color sidebar_backdrop_color {palette['bg']};

@define-color card_bg_color {palette['bg-alt']};
@define-color card_fg_color {palette['lightest']};

@define-color popover_bg_color {palette['bg-alt']};
@define-color popover_fg_color {palette['lightest']};

@define-color dialog_bg_color {palette['bg-alt']};
@define-color dialog_fg_color {palette['lightest']};

@define-color borders {palette['muted']};

@define-color theme_bg_color {palette['bg']};
@define-color theme_fg_color {palette['lightest']};
@define-color theme_base_color {palette['bg']};
@define-color theme_text_color {palette['lightest']};
@define-color theme_selected_bg_color {palette['accent']};
@define-color theme_selected_fg_color {palette['bg']};

@define-color insensitive_fg_color {palette['dim']};
@define-color insensitive_bg_color {palette['bg-alt']};

@define-color error_color {palette['warn']};
@define-color warning_color {palette['warn']};

/* Thunar sidebar hover */
.sidebar row:hover {{
    background-color: {palette['hover']};
}}

.sidebar row:selected {{
    background-color: {palette['accent']};
    color: {palette['bg']};
}}
"""
    for path in (GTK3_CSS, GTK4_CSS):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(css, encoding="utf-8")


def to_nano_hex(hex_color: str) -> str:
    h = hex_color.lstrip("#")
    return "#" + h[0] + h[2] + h[4]

def main() -> int:
    image = resolve_target(sys.argv[1:])

    rgb = dominant_color(image)
    palette = build_palette(rgb)
    write_css(palette, image)
    write_hypr_colors(palette)
    write_kitty_colors(palette)
    write_nano_colors(palette)
    write_hyprlock_colors(palette)
    write_fastfetch(palette)
    write_firefox_css(palette)
    write_swaync_css(palette)
    write_gtk_css(palette)
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(str(image), encoding="utf-8")

    if sys.argv[1] != "--regen":
        apply_wallpaper(image)

    restart_waybar()

    subprocess.run(["hyprctl", "reload"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["swaync-client", "-rs"], check=False,
                   stderr=subprocess.DEVNULL)
    subprocess.run(["pkill", "-USR1", "kitty"], check=False,
                   stderr=subprocess.DEVNULL)

    print(f"{image.name}  ->  accent {palette['accent']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
